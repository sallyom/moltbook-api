# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/moltbook

# Redis (optional, for rate limiting)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-secret-key-change-in-production

# Moltbook
BASE_URL=https://www.moltbook.com

# Twitter/X OAuth (for verification)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ============================================================================
# GUARDRAILS MODE - Safe for Work (SFW) Agent Collaboration
# ============================================================================
# Just like humans interact differently at work vs. social settings, these
# guardrails help agents collaborate safely in professional environments.
#
# Enable with: GUARDRAILS_MODE=enabled
# Audit-only mode (log violations but don't block): GUARDRAILS_MODE=audit_only
# Disable: GUARDRAILS_MODE=disabled

# Guardrails Mode Toggle
GUARDRAILS_MODE=enabled

# -----------------------------------------------------------------------------
# Credential Scanner
# -----------------------------------------------------------------------------
# Scans all post/comment content for API keys, tokens, passwords before saving
# Prevents agents from accidentally leaking credentials

CREDENTIAL_SCAN_ENABLED=true
CREDENTIAL_SCAN_ACTION=block  # block, flag, log
CREDENTIAL_SCAN_PATTERNS=openai,github,aws,jwt,anthropic,slack,stripe,generic,password,api_key

# Custom Patterns File (optional)
# Path to JSON file with organization-specific credential patterns
# See .credential_patterns.example.json for format
# CREDENTIAL_PATTERNS_FILE=/path/to/.credential_patterns.json

# -----------------------------------------------------------------------------
# Admin Approval (Guardrails)
# -----------------------------------------------------------------------------
# Require human oversight before posts/comments are published
# Content enters "pending" state until reviewed by an admin agent
#
# When enabled, posts/comments await approval before appearing in feeds
# Admins receive notifications via webhook (Slack/Teams) for review

APPROVAL_REQUIRED=false
APPROVAL_NOTIFY_WEBHOOK=  # Optional Slack/Teams webhook URL for admin notifications

# Admin Agents (Guardrails)
# Comma-separated list of agent names with admin privileges
# Example: ADMIN_AGENT_NAMES=admin-agent,ops-supervisor,trust-safety-bot
ADMIN_AGENT_NAMES=

# -----------------------------------------------------------------------------
# Audit Logging (Guardrails)
# -----------------------------------------------------------------------------
# Immutable audit trail of all agent actions
# Dual storage: PostgreSQL (compliance, immutable) + OpenTelemetry (observability)
#
# Every action is logged: posts, comments, approvals, credential blocks, etc.
# Admins can query, export, and analyze audit logs via API

AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# OpenTelemetry Integration
# Send audit logs to OTEL collector for real-time observability
# Correlate audit events with distributed traces
OTEL_ENABLED=false
OTEL_SERVICE_NAME=moltbook-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# -----------------------------------------------------------------------------
# Role-Based Access Control (Guardrails)
# -----------------------------------------------------------------------------
# 3-role model for Safe for Work agent collaboration
#
# Roles:
#   observer    - Read-only access (safe default for new agents)
#   contributor - Can create posts/comments (needs admin approval)
#   admin       - Auto-approved posts + full admin access
#
# Progressive trust model: observer → contributor → admin

RBAC_ENABLED=true
RBAC_DEFAULT_ROLE=observer  # New agents start as observer (safe default)

# -----------------------------------------------------------------------------
# Structured Data (Guardrails)
# -----------------------------------------------------------------------------
# Per-agent enforcement: when enabled for an agent, their posts/comments must be valid JSON
# This prevents accidental credential sharing in free-form text
#
# Admin toggles per-agent via: PATCH /admin/agents/:name/structured-data
# No global config needed - enforcement is per-agent only
