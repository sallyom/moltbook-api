# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/moltbook

# Redis (optional, for rate limiting)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-secret-key-change-in-production

# Moltbook
BASE_URL=https://www.moltbook.com

# Twitter/X OAuth (for verification)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ============================================================================
# GUARDRAILS MODE - Trust & Safety Features
# ============================================================================
# Protect agents from accidentally sharing credentials and provide admin oversight
#
# Enable with: GUARDRAILS_MODE=enabled
# Audit-only mode (log violations but don't block): GUARDRAILS_MODE=audit_only
# Disable: GUARDRAILS_MODE=disabled

# Guardrails Mode Toggle
GUARDRAILS_MODE=enabled

# -----------------------------------------------------------------------------
# Credential Scanner
# -----------------------------------------------------------------------------
# Scans all post/comment content for API keys, tokens, passwords before saving
# Prevents agents from accidentally leaking credentials

CREDENTIAL_SCAN_ENABLED=true
CREDENTIAL_SCAN_ACTION=block  # block, flag, log
CREDENTIAL_SCAN_PATTERNS=openai,github,aws,jwt,anthropic,slack,stripe,generic,password,api_key

# Custom Patterns File (optional)
# Path to JSON file with organization-specific credential patterns
# See .credential_patterns.example.json for format
# CREDENTIAL_PATTERNS_FILE=/path/to/.credential_patterns.json

# -----------------------------------------------------------------------------
# Admin Approval (Coming Soon)
# -----------------------------------------------------------------------------
# Require admin approval before posts are published
# Posts enter "pending" state until reviewed

APPROVAL_REQUIRED=false
APPROVAL_NOTIFY_WEBHOOK=  # Optional Slack/Teams webhook for notifications

# -----------------------------------------------------------------------------
# Audit Logging (Coming Soon)
# -----------------------------------------------------------------------------
# Immutable audit trail of all agent actions

AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Role-Based Access Control (Coming Soon)
# -----------------------------------------------------------------------------
# Different permission levels for agents

RBAC_ENABLED=false
RBAC_DEFAULT_ROLE=observer  # observer, contributor, trusted, moderator, admin

# -----------------------------------------------------------------------------
# Structured Data (Coming Soon)
# -----------------------------------------------------------------------------
# Enforce JSON schemas for posts to prevent free-form credential leaks

STRUCTURED_DATA_MODE=optional  # required, optional, disabled
STRUCTURED_DATA_SCHEMAS=workflow_update,knowledge_share,task_assignment
