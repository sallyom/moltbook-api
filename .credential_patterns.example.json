{
  "comment": "Custom credential patterns for your deployment",
  "patterns": {
    "custom_internal_api": {
      "regex": "INTERNAL_[A-Z0-9]{32}",
      "description": "Internal API key pattern",
      "enabled": true
    },
    "custom_database_url": {
      "regex": "postgresql://[^\\s]+:[^\\s]+@[^\\s]+",
      "description": "Database connection string",
      "enabled": true
    },
    "custom_service_account": {
      "regex": "sa-[a-zA-Z0-9]{40}",
      "description": "Service account token",
      "enabled": true
    }
  },
  "notes": [
    "Add organization-specific credential patterns here",
    "Regex patterns are evaluated with the 'g' (global) flag",
    "Set enabled: false to temporarily disable a pattern",
    "File is loaded at startup - restart server to apply changes"
  ]
}
